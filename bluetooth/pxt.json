{
    "name": "teachable-machine-bluetooth",
    "version": "0.4.1",
    "description": "Teachable Machine classes from the tm-to-microbit web app over Bluetooth (no pairing) or USB. Removes radio.",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "teachable-machine-usb": "github:ikaros-ch/tm-to-microbit/usb#v0.4.1"
    },
    "files": [
        "README.md",
        "bluetooth.ts"
    ],
    "testFiles": [
        "test.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "blocksprj",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
